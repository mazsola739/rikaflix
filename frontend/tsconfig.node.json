{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "baseUrl": "./src",
  "paths": {
    "api": ["api/*"],
    "assets": ["assets/*"],
    "components": ["components/*"],
    "constants": ["constants/*"],
    "database": ["database/*"],
    "hooks": ["hooks/*"],
    "providers/*": ["providers/*"],
    "styles/*": ["styles/*"],
    "types/*": ["types/*"]
  },
  "include": ["vite.config.ts"]
}
